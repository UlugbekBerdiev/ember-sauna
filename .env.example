# Local PostgreSQL connection (replace placeholders for your machine)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/ember_sauna?schema=public"

# Generate a unique random value with at least 32 characters.
SESSION_SECRET=""

# Generate a private setup code. At least 32 characters is recommended.
ADMIN_SETUP_CODE=""

# Optional seed-time admin creation. Leave both unset to use /admin/setup.
ADMIN_USERNAME=""
ADMIN_PASSWORD=""

# Optional; AdminUser.email may be omitted.
ADMIN_EMAIL=""

# Optional. Address suggestions work without this key.
# ARCGIS_API_KEY=""
